{
  "name": "hordunlarmy.github.io",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://hordunlarmy.github.io",
  "dependencies": {
    "@types/node": "^16.18.6",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.7.1",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "docker:build": "docker build -t hordunlarmy.github.io .",
    "docker:build:dev": "docker build -f Dockerfile.dev -t hordunlarmy.github.io:dev .",
    "docker:run": "docker run -p 8050:8050 hordunlarmy.github.io",
    "docker:run:dev": "docker run -p 3000:3000 -v $(pwd):/app -v /app/node_modules hordunlarmy.github.io:dev",
    "docker:compose:dev": "docker-compose --profile dev up --build",
    "docker:compose:prod": "docker-compose --profile prod up --build",
    "docker:compose:dev-hot": "docker-compose --profile dev-hot up --build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.13",
    "gh-pages": "^4.0.0",
    "postcss": "^8.4.19",
    "prettier": "^2.8.1",
    "tailwindcss": "^3.2.4"
  }
}
